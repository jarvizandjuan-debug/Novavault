</ul>
</div>
<div>
<h3>Tienda</h3>
<ul>
<li><a href="/products/flapping-bird-interactive-cat-toy">Gorrión Cazador</a></li>
<li><a href="/cart">Carrito</a></li>
<li><a href="/policies/privacy-policy">Privacidad</a></li>
<li><a href="/policies/terms-of-service">Términos</a></li>
</ul>
</div>
<div class="legal"><span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span><span>Supervisa siempre el juego de tu gato.</span></div>
</div>
</footer>
