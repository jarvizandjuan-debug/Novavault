<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
  dir="{{ request.locale.direction | default: 'ltr' }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {%- render 'view-transition-opt-in' -%}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'card-hover-effect-styles' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}

    {% render 'chat-drawer' %}

    <div class="page-wrapper">
      {%- comment -%} Barra Gorrión Cazador: cuenta regresiva hasta la medianoche local + llamado a la acción. En la portada no sale: la portada PawPlay trae su propia barra. {%- endcomment -%}
      {%- unless page.handle == 'gorrion-cazador' or template.name == 'index' -%}
        {%- assign gz_product = all_products['flapping-bird-interactive-cat-toy'] -%}
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,800&display=swap">
        <style>
          .gz-bar { --gz-ink: #2e2219; --gz-paper: #f6f1e8; --gz-beak: #f3bd1f; --gz-bow: #c8323a; background: var(--gz-ink); color: var(--gz-paper); position: relative; z-index: 5; }
          .gz-bar__in { max-width: 1200px; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px 22px; padding: 10px max(16px, env(safe-area-inset-right, 0px)) 10px max(16px, env(safe-area-inset-left, 0px)); text-align: center; }
          .gz-bar__cta { font-family: "Bricolage Grotesque", "Arial Black", system-ui, sans-serif; font-weight: 800; font-size: 19px; line-height: 1.1; letter-spacing: -0.01em; margin: 0; color: inherit; }
          .gz-bar__cta mark { background: linear-gradient(transparent 55%, var(--gz-beak) 55%, var(--gz-beak) 92%, transparent 92%); color: inherit; padding: 0 .05em; }
          .gz-bar__timer { display: flex; align-items: center; gap: 10px; }
          .gz-bar__label { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; opacity: .85; display: flex; align-items: center; gap: 7px; }
          .gz-bar__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--gz-bow); animation: gz-blink 1.2s infinite; }
          .gz-bar__clock { display: flex; align-items: flex-start; gap: 4px; font-family: "Bricolage Grotesque", "Arial Black", system-ui, sans-serif; font-variant-numeric: tabular-nums; }
          .gz-bar__unit { display: flex; flex-direction: column; align-items: center; min-width: 2.4ch; }
          .gz-bar__num { font-size: 22px; font-weight: 800; line-height: 1; display: inline-block; }
          .gz-bar__num.is-tick { animation: gz-tick .45s cubic-bezier(.2,.9,.3,1.3); }
          .gz-bar__unit small { font-weight: 600; font-size: 9px; letter-spacing: .1em; text-transform: uppercase; opacity: .7; margin-top: 2px; }
          .gz-bar__sep { font-size: 20px; font-weight: 800; line-height: 1; opacity: .5; }
          .gz-bar__btn { display: inline-flex; align-items: center; gap: 6px; background: var(--gz-beak); color: var(--gz-ink) !important; text-decoration: none !important; font-weight: 800; font-size: 14px; padding: 8px 16px; border-radius: 999px; box-shadow: 0 3px 0 rgba(0,0,0,.35); transition: transform .15s; animation: gz-nudge 3.2s ease-in-out 1s infinite; }
          .gz-bar__btn:hover { transform: translateY(-2px); animation-play-state: paused; }
          .gz-bar__btn:focus-visible { outline: 3px solid var(--gz-paper); outline-offset: 3px; }
          @keyframes gz-blink { 50% { opacity: .25; } }
          @keyframes gz-tick { 0% { transform: translateY(-40%) scale(.9); opacity: .2; } 100% { transform: none; opacity: 1; } }
          @keyframes gz-nudge { 0%, 86%, 100% { transform: none; } 89% { transform: rotate(-3deg); } 93% { transform: rotate(3deg); } 96% { transform: rotate(-1.5deg); } }
          @media (max-width: 600px) { .gz-bar__cta { font-size: 16px; flex-basis: 100%; } .gz-bar__num { font-size: 18px; } .gz-bar__btn { font-size: 13px; padding: 7px 13px; } }
          @media (prefers-reduced-motion: reduce) { .gz-bar *, .gz-bar *::before { animation: none !important; transition: none !important; } }
        </style>
        <div class="gz-bar" role="region" aria-label="Oferta del día">
          <div class="gz-bar__in">
            <p class="gz-bar__cta">Tu gato nació para <mark>cazar</mark>. Dale su presa hoy.</p>
            <div class="gz-bar__timer">
              <span class="gz-bar__label"><span class="gz-bar__dot" aria-hidden="true"></span>El día termina en</span>
              <div class="gz-bar__clock" data-gz-clock>
                <span class="gz-bar__unit"><span class="gz-bar__num" data-gz-h>00</span><small>h</small></span><span class="gz-bar__sep">:</span>
                <span class="gz-bar__unit"><span class="gz-bar__num" data-gz-m>00</span><small>min</small></span><span class="gz-bar__sep">:</span>
                <span class="gz-bar__unit"><span class="gz-bar__num" data-gz-s>00</span><small>seg</small></span>
              </div>
            </div>
            <a class="gz-bar__btn" href="{%- if gz_product.selected_or_first_available_variant -%}/cart/{{ gz_product.selected_or_first_available_variant.id }}:1{%- else -%}/products/flapping-bird-interactive-cat-toy{%- endif -%}">Comprar{% if gz_product.price %} · {{ gz_product.price | money }}{% endif %} &rarr;</a>
          </div>
        </div>
        <script>
          (function () {
            var root = document.querySelector('[data-gz-clock]');
            if (!root) return;
            var last = {};
            function pad(n) { return (n < 10 ? '0' : '') + n; }
            function set(k, v) {
              if (last[k] === v) return;
              last[k] = v;
              var el = root.querySelector('[data-gz-' + k + ']');
              el.textContent = v;
              el.classList.remove('is-tick'); void el.offsetWidth; el.classList.add('is-tick');
            }
            function update() {
              var now = new Date();
              var end = new Date(now); end.setHours(24, 0, 0, 0);
              var left = Math.max(0, Math.floor((end - now) / 1000));
              set('h', pad(Math.floor(left / 3600)));
              set('m', pad(Math.floor(left % 3600 / 60)));
              set('s', pad(left % 60));
            }
            update(); setInterval(update, 1000);
          })();
        </script>
      {%- endunless -%}

      <div id="header-group">
        {%- unless false -%}
          {% sections 'header-group' %}
        {%- endunless -%}
      </div>

      <script>
        window.measureHeaderHeights = (function () {
          let measured = false;

          return function measureHeaderHeights() {
            if (measured) return;

            const header = document.querySelector('#header-component');
            const headerGroup = document.querySelector('#header-group');

            if (!header || !headerGroup) return;
            measured = true;

            const headerHeight = header.offsetHeight;

            let headerGroupHeight = 0;
            for (const element of headerGroup.children) {
              if (element instanceof HTMLElement) headerGroupHeight += element.offsetHeight;
            }

            if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
              headerGroupHeight += headerHeight;
            }

            document.body.style.setProperty('--header-height', `${headerHeight}px`);
            document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);
          };
        })();

        if (document.querySelector('#header-component')?.hasAttribute('transparent')) {
          measureHeaderHeights();
        }

        (function setTopRowHeight() {
          const header = document.querySelector('#header-component');
          const headerTopRow = header?.querySelector('.header__row--top');
          if (!headerTopRow) return;

          window.requestAnimationFrame(function () {
            header.style.setProperty('--top-row-height', `${headerTopRow.getBoundingClientRect().height}px`);
          });
        })();

        (function updateTransparentHeaderOffset() {
          const header = document.querySelector('#header-component');
          const headerSection = document.querySelector('#header-group .header-section');
          if (!headerSection || !header?.hasAttribute('transparent')) return;

          const hasImmediateSection = headerSection.nextElementSibling?.classList.contains('shopify-section');
          if (!hasImmediateSection) {
            document.body.style.setProperty('--transparent-header-offset-boolean', '1');
          }
        })();

        (function setHeaderMenuStyle() {
          const headerComponent = document.querySelector('#header-component');
          if (headerComponent) {
            const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
            const overflowList = headerComponent.querySelector('overflow-list');
            const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
            headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
          }
        })();
      </script>

      <main
        id="MainContent"
        class="content-for-layout"
        role="main"
        data-page-transition-enabled="{{ settings.page_transition_enabled }}"
        data-product-transition="{{ settings.transition_to_main_product }}"
        data-template="{{ template }}"
      >
        {%- unless false -%}
          {{ content_for_layout }}
        {%- else -%}
{%- comment -%} PawPlay · Portada del Gorrión Cazador. Las reseñas salen de los metaobjetos "pawplay_review" (Contenido > Metaobjetos). La nota media y el total se calculan solos; si no hay ninguna reseña no se muestra ninguna cifra. {%- endcomment -%}
{%- assign p = all_products['flapping-bird-interactive-cat-toy'] -%}
{%- assign v = p.selected_or_first_available_variant -%}
{%- if v -%}
{%- capture buy_url -%}/cart/{{ v.id }}:1{%- endcapture -%}
{%- else -%}
{%- assign buy_url = '/products/flapping-bird-interactive-cat-toy' -%}
{%- endif -%}
{%- assign logo_src = 'https://cdn.shopify.com/s/files/1/0852/3454/8951/files/file_0000000018c481fd931476b18e86cd89.png?crop=region&crop_left=70&crop_top=280&crop_width=1150&crop_height=670' -%}
{%- assign reviews = shop.metaobjects.pawplay_review.values -%}
{%- assign r_count = 0 -%}
{%- assign r_sum = 0 -%}
{%- for r in reviews -%}
{%- assign r_count = r_count | plus: 1 -%}
{%- assign r_sum = r_sum | plus: r.rating.value -%}
{%- endfor -%}
{%- if r_count > 0 -%}
{%- assign r_avg = r_sum | times: 1.0 | divided_by: r_count | round: 1 -%}
{%- assign r_full = r_avg | round -%}
{%- endif -%}
{%- capture star -%}<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.6 7.7l5.8-.8z"/></svg>{%- endcapture -%}
{%- capture check -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 1.5l2.4 1.8 3-.1 1 2.8 2.5 1.7-.9 2.9.9 2.9-2.5 1.7-1 2.8-3-.1L12 20.4l-2.4-1.8-3 .1-1-2.8-2.5-1.7.9-2.9-.9-2.9 2.5-1.7 1-2.8 3 .1z"/><path d="M8 11.2l2.6 2.6L16.2 8" fill="none" stroke="#331608" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}
{%- capture arrow -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>{%- endcapture -%}
