 target='_blank' rel='noopener'>@paw_play_usa</a></div></section>{% raw %}<script>(function(){var root=document.currentScript.parentNode;root.querySelectorAll('[data-qv]').forEach(function(card){card.addEventListener('click',function(e){var d=document.getElementById(card.getAttribute('data-qv'));if(!d||!d.showModal)return;e.preventDefault();d.showModal();});});root.querySelectorAll('dialog.qv').forEach(function(d){d.addEventListener('click',function(e){if(e.target===d||e.target.closest('[data-close]'))d.close();});var main=d.querySelector('.main');d.querySelectorAll('.th').forEach(function(t){t.addEventListener('click',function(){main.src=t.getAttribute('data-src');d.querySelectorAll('.th').forEach(function(o){o.classList.remove('on')});t.classList.add('on');});});var sel=d.querySelector('[data-variant]'),pr=d.querySelector('[data-price]');if(sel&&pr){sel.addEventListener('change',function(){var o=sel.options[sel.selectedIndex];pr.textContent=o.getAttribute('data-price');});}});})();</script>{% endraw %}</div>
