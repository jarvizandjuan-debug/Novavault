o{% endif %}</span>{% endif %}<div class='ph'><img src='{{ p.featured_image | image_url: width: 700 }}' width='700' height='700' {% if forloop.index > 3 %}loading='lazy'{% endif %} alt='{{ p.featured_image.alt | default: p.title | escape }}'></div><div class='meta'><h3>{{ p.title }}</h3><p class='pr'>{% if p.price_varies %}<small>{% if en %}From{% else %}Desde{% endif %}</small>{% endif %}{{ p.price_min | money }}</p>{% if p.variants.size > 1 %}<span class='opts'>{{ p.variants.size }} {% if en %}options{% else %}opciones{% endif %}</span>{% endif %}<span class='go'><b>{% if en %}View product{% else %}Ver producto{% endif %} →</b></span></div></a>{% endfor %}</div>{% for p in col.products %}<dialog class='qv' id='qv-{{ p.id }}' aria-labelledby='qvt-{{ p.id }}'><button class='x' type='button' data-close aria-label='{% if en %}Close{% else %}Cerrar{% endif %}'>✕</button><div class='qvgrid'><div class='gal'><img class='main' src='{{ p.featured_image | image_url: width: 900 }}' width='900' height='900' alt='{{ p.title | escape }}'><div class='thumbs'>{% for img in p.images limit: 8 %}<button type='button' class='th{% if forloop.first %} on{% endif %}' data-src='{{ img | image_url: width: 900 }}' aria-label='{% if en %}Photo{% else %}Foto{% endif %} {{ forloop.index }}'><img src='{{ img | image_url: width: 160 }}' width='160' height='160' loading='lazy' alt=''></button>{% endfor %}</div></div><div class='info'><h3 id='qvt-{{ p.id }}'>{{ p.title }}</h3><p class='pr' data-price>{{ p.selected_or_first_available_variant.price | money }}</p><form method='post' action='{{ routes.cart_add_url }}' class='buy'>{% if p.variants.size > 1 %}<label class='lbl' for='v-{{ p.id }}'>{% if en %}Choose an option{% else %}Elige una opción{% endif %}</label><select id='v-{{ p.id }}' name='id' data-variant>{% for v in p.variants %}<option value='{{ v.id }}' data-price='{{ v.price | money }}' {% unless v.available %}disabled{% endunless %} {% if v.id == p.selected_or_first_available_variant.id 